# ================================================================
# 教学 Agent 部署 .env —— 仅存放【密钥】与【模型配置】
# 其余固定配置（端口、内网 URL、内存、LangSmith 端点等）硬编码在 docker-compose.yml
# 使用方法：cp .env.example .env 后填写真实值
# ================================================================

# ---------- 密钥 / 凭证 ----------
POSTGRES_PASSWORD=change-me
NEO4J_PASSWORD=change-me
DASHSCOPE_API_KEY=sk-xxx
AGENT_SERVER_SECRET=replace-with-a-random-secret
LANGSMITH_API_KEY=

# ---------- 模型配置 ----------
# lightrag 对话模型（知识库索引/问答）
LIGHTRAG_LLM_MODEL=deepseek-v4-flash
# agent_server 对话模型（教学 Agent 主对话）
AGENT_LLM_MODEL=deepseek-v4-flash
# lightrag 嵌入模型（向量化）
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024