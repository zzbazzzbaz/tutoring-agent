# === LLM ===
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash

# === LangSmith 可观测 ===
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=teaching-agent

# === Agent Server ===
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
AGENT_SERVER_SECRET=replace-with-a-random-secret
LIGHTRAG_QUERY_URL=http://127.0.0.1:19621/query

# === Agent 中间件 ===
# 单个工具调用失败后最大重试次数（0 = 不重试）
AGENT_TOOL_MAX_RETRIES=2
# 消息历史总 token 数（近似计数）超过该阈值时触发摘要压缩
AGENT_CONTEXT_TRIGGER_TOKENS=8000
# 压缩后保留的最近消息条数
AGENT_CONTEXT_KEEP_MESSAGES=30

# === DB ===
# LangGraph checkpoint 专用库（业务数据在 api_server 的 tutoring_db）
LANGGRAPH_POSTGRES_URI=postgresql://tutoring:change-me@host.docker.internal:15423/tutoring_agent_server_db?sslmode=disable