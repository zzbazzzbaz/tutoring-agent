# Agent Server currently loads ../api_server/.env; place the following values there.
# === LLM  ===
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.6-flash

# === LangSmith  ===
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=teaching-agent

# === Agent Server ===
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
AGENT_SERVER_SECRET=replace-with-a-random-secret
LIGHTRAG_QUERY_URL=http://127.0.0.1:19621/query
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
