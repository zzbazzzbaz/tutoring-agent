# === 数据库 ===
DATABASE_URL=postgresql+asyncpg://user:password@xxx.xxx.xxx.xxx:xxx/tutoring_db

# 与 Agent Server 共享的内部回调凭证
AGENT_SERVER_SECRET=replace-with-a-random-secret

# === 语音模块（DashScope 语音） ===

# === LLM 研究摘要（DashScope 通义千问，统计分析"研究摘要"用） ===
# 填入真实 DashScope API Key 后，报告页研究摘要由大模型生成（source=llm）；
# 留占位符/未配置时，接口返回 503（SUMMARY_UNAVAILABLE），由前端报告页回退为本地规则摘要（source=rule）
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash
